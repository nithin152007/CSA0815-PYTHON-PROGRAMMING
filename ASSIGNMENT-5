import re
import csv
import sqlite3
from collections import Counter

positive_words = {
    "good", "clean", "fast", "helpful", "improved"
}

negative_words = {
    "bad", "dirty", "slow", "rude", "smoke", "broken"
}

negation_words = {
    "not", "never", "no"
}


def analyse_sentiment(text):
    words = re.findall(r"\b[a-z]+\b", text.lower())

    score = 0

    for i, word in enumerate(words):

        if word in positive_words:
            value = 1

        elif word in negative_words:
            value = -1

        else:
            continue

        previous_words = words[max(0, i - 3):i]

        if any(w in negation_words for w in previous_words):
            value *= -1

        score += value

    if score > 0:
        return "Positive"

    elif score < 0:
        return "Negative"

    return "Neutral"


def summarise_text(text):
    sentences = re.split(r'(?<=[.!?])\s+', text.strip())

    words = re.findall(r"\b[a-z]+\b", text.lower())

    common_words = Counter(
        word for word in words
        if len(word) > 3
    )

    important_words = {
        word for word, count in common_words.most_common(5)
    }

    selected = []

    for sentence in sentences:
        sentence_words = set(
            re.findall(r"\b[a-z]+\b", sentence.lower())
        )

        if sentence_words.intersection(important_words):
            selected.append(sentence)

    return " ".join(selected)


def validate_model():

    correct = 0
    total = 0

    try:
        with open(
            "complaints.csv",
            "r",
            newline="",
            encoding="utf-8"
        ) as file:

            reader = csv.DictReader(file)

            for row in reader:
                complaint = row["complaint"]
                manual_label = row["manual_label"].strip().capitalize()

                predicted_label = analyse_sentiment(complaint)

                if predicted_label == manual_label:
                    correct += 1

                total += 1

        if total < 50:
            print("Please provide at least 50 complaints.")
            return

        agreement = (correct / total) * 100

        print("\nVALIDATION RESULTS")
        print("Total complaints:", total)
        print("Correct labels:", correct)
        print("Agreement percentage:", round(agreement, 2), "%")

    except FileNotFoundError:
        print("complaints.csv file not found.")

    except KeyError:
        print("CSV must contain complaint and manual_label columns.")


def create_database():

    connection = sqlite3.connect("air_quality.db")

    cursor = connection.cursor()

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS readings (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            station TEXT,
            day TEXT,
            temperature REAL
        )
    """)

    cursor.execute("""
        CREATE INDEX IF NOT EXISTS idx_station_day
        ON readings(station, day)
    """)

    connection.commit()
    connection.close()

    print("\nDatabase and index created successfully.")


def main():

    complaints = [
        "Roads are clean and bus was fast",
        "Smoke from factory, air is bad",
        "Staff were not helpful",
        "Not bad, service improved"
    ]

    print("SENTIMENT ANALYSIS\n")

    for complaint in complaints:
        result = analyse_sentiment(complaint)

        print("Complaint:", complaint)
        print("Sentiment:", result)
        print()

    print("TEXT SUMMARISATION\n")

    text = (
        "The city roads are clean. "
        "Clean roads improve public health. "
        "People need clean air and better transport."
    )

    print(summarise_text(text))

    validate_model()

    create_database()


if __name__ == "__main__":
    main()
